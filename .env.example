# Copy to .env and fill in. Only EXPO_PUBLIC_* values reach the app, and they are
# visible to anyone who has the app, so never put secrets here.

# Optional Supabase project: accounts and sync, the remote kill switch, and analytics.
# Leave empty to keep everything on the device (events queue up locally, capped).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Ads ship switched off. Turn on for adults 4 to 8 weeks after launch.
EXPO_PUBLIC_ADS_ENABLED=false

# RevenueCat public SDK keys (Phase 4).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Shows the developer section (ad placement preview) in release builds.
EXPO_PUBLIC_DEV_TOOLS=false
